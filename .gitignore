# 依赖
node_modules/
dist/
__pycache__/
*.pyc
.venv/
venv/

# 模型权重（体积大，默认不入库；集中存放于 weights/ 按用途分子目录）
*.pt
# 例外：weights/ 集中目录下的权重允许入库（按用户要求随仓库分发）
!weights/
!weights/**/
!weights/**/*.pt

# 抓拍图片与本地数据库（后端运行时生成）
backend/images/
*.db
*.jpg
*.jpeg


# 文档截图例外：README 展示用截图允许入库
!doc/images/screenshots/
!doc/images/screenshots/*.png

# 测试视频（体积大，不入库）
videos/

# 环境变量
.env
*.local

# IDE
.vscode/
.idea/
.DS_Store

# 本地孤儿记录备份（运维产物，不入库）
backend/orphan_violations_backup_*.json
