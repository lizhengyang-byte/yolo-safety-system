# 后端环境变量示例：复制为 backend/.env 后按需修改
# （uvicorn 需在 backend/ 目录启动，pydantic-settings 会读取 backend/.env）

# ---------- 预警邮件通知（SMTP）----------
# 这里的值只是“初始默认值”，登录后台「预警中心 → 预警配置」后可在网页上修改，
# 网页保存的配置存于 system_settings 表，优先级高于本文件。
# 未配置 SMTP_HOST / MAIL_TO 时自动跳过发送，不影响系统运行
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=alert@example.com
SMTP_PASSWORD=your-smtp-password-or-auth-code
# 465 端口用 SSL；587 端口请设 SMTP_SSL=false、SMTP_STARTTLS=true
SMTP_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=alert@example.com
# 多个收件人用英文逗号分隔
MAIL_TO=manager@example.com,security@example.com

# ---------- 火源火灾检测（第二模型，与 PPE 并行；全部摄像头同时检测）----------
# 演示模式（后端直接推理）加载火源/烟雾模型 fire.pt。默认开启。
# docker 中挂载路径为 /app/weights/fire.pt；本地开发会按相对路径自动搜索。
DEMO_FIRE_ENABLED=true
# DEMO_FIRE_MODEL_PATH=/app/weights/fire.pt
DEMO_FIRE_CONF_THRESHOLD=0.4
